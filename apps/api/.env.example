# Glassbeetle API configuration.
#
# Every setting is optional: the API starts with sensible per-user defaults.
# Copy this file to `.env` only if you need to override something.

# Run mode: development | production | test
# NODE_ENV=development

# Port the API listens on. It binds to 127.0.0.1 only.
# PORT=3000

# Root directory for the database and application data. By default, uploaded
# files, artifacts and backups are stored below this directory as well.
# Must be an absolute path. Defaults to a per-user application data directory:
#   macOS   ~/Library/Application Support/Glassbeetle
#   Windows %APPDATA%\Glassbeetle
#   Linux   $XDG_DATA_HOME/glassbeetle (or ~/.local/share/glassbeetle)
# GLASSBEETLE_DATA_DIR=/absolute/path/to/data

# Root directory for uploaded pictures, project images, artifacts and backups.
# Defaults to <data dir>/storage. This is independent of the database path;
# a non-empty relative path is resolved from the API working directory.
# GLASSBEETLE_STORAGE_ROOT=/absolute/path/to/storage

# Absolute path of the SQLite database file.
# Defaults to <data dir>/glassbeetle.db
# GLASSBEETLE_DATABASE_PATH=/absolute/path/to/glassbeetle.db

# Comma-separated CORS allowlist. Defaults to the three origins the desktop app
# uses. Set it to an empty value to allow no cross-origin requests at all.
# GLASSBEETLE_CORS_ORIGINS=http://localhost:4200,tauri://localhost,http://tauri.localhost

# Operational log level: debug | log | info | warn | error. Defaults to log.
# See docs/logging.md for request-body redaction and logging details.
# GLASSBEETLE_LOG_LEVEL=log

# Request-body logging: only true or 1 (case-insensitive) enables it; any other
# value, including false, 0, or unset, disables it.
# See docs/logging.md for the redaction rules.
# GLASSBEETLE_LOG_BODY=false

# Maximum uploaded agent-picture size, in bytes. Must be a positive integer.
# Defaults to 5242880 (5 MiB).
# GLASSBEETLE_MAX_PICTURE_SIZE_BYTES=5242880

# Path to the 256-bit AES master key file used for encrypting credentials at rest.
# Must be an absolute path. Defaults to <data dir>/master.key.
# GLASSBEETLE_MASTER_KEY_FILE=/absolute/path/to/master.key

# Alternatively, the 32-byte master key can be supplied directly in hex or base64.
# Primarily useful for ephemeral test runs or containerised deployments.
# GLASSBEETLE_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Name the user profile is seeded with on first read. Unset, the API asks the
# operating system for the account name; a later change through the API is never
# overwritten by this setting.
# GLASSBEETLE_USER_NAME=Ada
